---
const fm = Astro.props.frontmatter;
const { title, description = 'A community guide to building a software factory with AI coding agents: a simulator, a playbook, a manifesto and stories from real teams.' } = fm ?? Astro.props;
const { fullTitle, type = fm ? 'article' : 'website', author = fm?.author } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} · The Software Factory` : 'The Software Factory');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const person = { '@type': 'Person', name: 'Ofir Makmal', url: 'https://il.linkedin.com/in/ofirmakmal' };
const site = { '@type': 'WebSite', name: 'The Software Factory', url: Astro.site.href };
const ld = type === 'article'
  ? { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, url: canonical, image: ogImage, author: person, publisher: { '@type': 'Organization', name: 'The Software Factory', url: Astro.site.href }, isPartOf: site, ...(fm?.date ? { datePublished: fm.date } : {}) }
  : { '@context': 'https://schema.org', ...site, description, author: person };
// Credit links. Leave a value empty to hide that link.
const linkedin = 'https://il.linkedin.com/in/ofirmakmal';
const xAuthor = '@ofirmakmal';
const xSite = '@marshalcodes';
const marshalLogo = '/logos/marshal.svg';
const nav = [['/lights-out/', 'Lights Out'], ['/manifesto/', 'Manifesto'], ['/playbook/', 'Playbook'], ['/journey/', 'Journey'], ['/stories/', 'Stories']];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#f1f2ec">
<meta property="og:site_name" content="The Software Factory">
<meta property="og:type" content={type}>
<meta property="og:title" content={title || 'The Software Factory'}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{xSite && <meta name="twitter:site" content={xSite}>}
{xAuthor && <meta name="twitter:creator" content={xAuthor}>}
<meta name="twitter:title" content={title || 'The Software Factory'}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
{author && <meta name="author" content={author}>}
<script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;900&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root {
  --bg: #f1f2ec; --panel: #fbfbf8; color-scheme: light; --ink: #18201d; --muted: #5d6862; --line: #c3c8bc; --accent: #b86e00;
  --display: 'Big Shoulders Display', 'Arial Narrow', Impact, sans-serif;
  --body: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: var(--bg); color: var(--ink); font: 400 17px/1.6 var(--body); }
a { color: var(--accent); }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.shell { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
.nav { display: flex; flex-wrap: wrap; gap: 8px 22px; align-items: baseline; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid var(--line); }
.nav .home { font: 900 24px/1 var(--display); text-transform: uppercase; letter-spacing: .03em; color: var(--ink); text-decoration: none; }
.nav ul { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; margin: 0; padding: 0; font-size: 15px; }
.nav ul a { color: var(--ink); text-decoration: none; border-bottom: 2px solid transparent; }
.nav ul a:hover { border-color: var(--accent); }
.nav ul .gh { border: 1px solid var(--ink); padding: 2px 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
.nav ul .gh::before { content: ''; width: 15px; height: 15px; background: currentColor; -webkit-mask: url(/logos/github.svg) center / contain no-repeat; mask: url(/logos/github.svg) center / contain no-repeat; }
main { padding: 44px 0 72px; }
h1, h2, h3 { font-family: var(--display); font-weight: 900; text-transform: uppercase; line-height: .95; text-wrap: balance; margin: 0; }
h1 { font-size: clamp(44px, 8vw, 96px); letter-spacing: -.005em; }
h2 { font-size: 34px; margin-top: 48px; }
h3 { font-size: 22px; letter-spacing: .04em; margin-top: 28px; }
.prose { max-width: 66ch; }
.prose p, .prose li { color: var(--ink); }
.prose > p:first-of-type { font-size: 21px; line-height: 1.45; }
.prose h1 { margin-bottom: 24px; }
.prose h1.long { font-size: clamp(36px, 5.5vw, 64px); }
.byline { font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin: -8px 0 20px; }
.prose > .byline + p { font-size: 21px; line-height: 1.45; }
.prose table { border-collapse: collapse; width: 100%; font-size: 15px; display: block; overflow-x: auto; }
.prose th, .prose td { border-bottom: 1px solid var(--line); padding: 8px 12px 8px 0; text-align: left; vertical-align: top; }
.prose th { font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
.draft { font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); border: 1px solid var(--accent); padding: 2px 8px; display: inline-block; margin-bottom: 16px; }
.btn { display: inline-block; background: var(--accent); color: var(--bg); font-weight: 600; padding: 12px 20px; text-decoration: none; }
footer .by { margin: 0; }
footer .who { font-weight: 600; color: var(--ink); }
footer .share a { margin-left: 10px; }
footer .co { white-space: nowrap; color: var(--ink); font-weight: 600; }
footer .co img { vertical-align: -3px; margin-right: 4px; }
footer { border-top: 1px solid var(--line); padding: 20px 0 40px; color: var(--muted); font-size: 14px; display: grid; gap: 12px; }
footer .row { display: flex; flex-wrap: wrap; gap: 6px 24px; justify-content: space-between; }
footer .nw { white-space: nowrap; }
</style>
<script is:inline defer src="/analytics.js"></script>
<script is:inline defer src="/consent.js"></script>
</head>
<body>
<div class="shell">
  <nav class="nav" aria-label="Main">
    <a class="home" href="/">The Software Factory</a>
    <ul>{nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}<li><a class="gh" href="https://github.com/marshal-org/the-software-factory" target="_blank" rel="noopener">GitHub</a></li></ul>
  </nav>
  <main><div class={Astro.props.frontmatter ? 'prose' : ''}>
    {fm?.draft !== false && fm && <span class="draft">Open for argument</span>}
    {Astro.props.frontmatter?.title && <h1 class={Astro.props.frontmatter.title.length > 30 ? 'long' : ''}>{Astro.props.frontmatter.title}</h1>}
    {Astro.props.frontmatter?.author && <p class="byline">By {Astro.props.frontmatter.author}</p>}
    <slot />
  </div></main>
  <footer>
    <p class="by">A community project about the road to software factories. Started by <span class="who">Ofir Makmal</span>{' '}
      <span class="nw">(<a href={linkedin} rel="me noopener">LinkedIn</a>, <a href={`https://x.com/${xAuthor.slice(1)}`} rel="me noopener">X</a>)</span>, founder of{' '}
      <span class="nw"><a class="co" href="https://marshal.codes/?utm_source=thesoftwarefactory"><img src={marshalLogo} alt="Marshal logo" width="16" height="16" />Marshal</a> (<a href={`https://x.com/${xSite.slice(1)}`} rel="noopener">X</a>)</span> and{' '}
      <a class="co" href="https://runlease.online/?utm_source=thesoftwarefactory"><img src="/logos/runlease.svg" alt="Runlease logo" width="16" height="16" />Runlease</a>.
      He has led engineering at several startups as VP Engineering and CTO, and spent years as a consultant helping dozens of engineering teams tune both their software and the way they deliver it.</p>
    <div class="row">
      <span><a href="/what-is-a-software-factory/">What is a software factory?</a> · <a href="/privacy/">Privacy</a> · <a href="/privacy/" data-consent-open>Cookie settings</a> · Code MIT, words CC BY 4.0</span>
      <span class="share">Share this page: <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener">LinkedIn</a><a href={`https://x.com/intent/post?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(title || 'The Software Factory')}&via=${xSite.slice(1)}`} target="_blank" rel="noopener">X</a><a href={`https://wa.me/?text=${encodeURIComponent((title || 'The Software Factory') + ' ' + canonical)}`} target="_blank" rel="noopener">WhatsApp</a></span>
    </div>
  </footer>
</div>
</body>
</html>
